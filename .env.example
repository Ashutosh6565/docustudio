# DOCUSTUDIO — 100% free stack. No API key, no billing.
#
# Screenplay: built-in director (offline). Scene stills: Wikimedia Commons.
# Optional: hero image + Pollinations screenwriter (keyless).
FREE_TEXT_ENDPOINT=https://text.pollinations.ai/openai
FREE_TEXT_MODEL=openai
FREE_IMAGE_MODEL=flux
FREE_CONCURRENCY=3
# Python with the `edge-tts` package installed (pip install edge-tts).
EDGE_TTS_PYTHON=python

# Optional legacy Gemini path. Leave empty to stay free.
GEMINI_API_KEY=

# Set to 1 to force mock mode (placeholder stills, silent narration).
MOCK=

# ffmpeg / ffprobe binaries. Leave as-is if they are on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
